                         state="readonly", width=14, font=("Arial", 12))
    combo.pack(side="left", padx=10)

    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Hub.Treeview", background=c["panel"], foreground=c["fg"],
                    fieldbackground=c["panel"], rowheight=34, font=("Arial", 12))
    style.configure("Hub.Treeview.Heading", background=c["accent"], foreground="#000000",
                    font=("Arial", 12, "bold"))
    style.map("Hub.Treeview", background=[("selected", c["entry"])], foreground=[("selected", c["fg"])])

    tree = ttk.Treeview(root, columns=("rank", "player", "score"), show="headings",
                        style="Hub.Treeview", height=10)
    tree.heading("rank", text="Rank")
    tree.heading("player", text="Player")
    tree.heading("score", text="Score")
    tree.column("rank", width=90, anchor="center")
    tree.column("player", width=300, anchor="center")
    tree.column("score", width=150, anchor="center")
    tree.tag_configure("gold", foreground="#e0a800")
    tree.tag_configure("silver", foreground="#8e9aaf")
    tree.tag_configure("bronze", foreground="#cd7f32")
    tree.pack(pady=5)

    note = make_label(root, "", 12, color=c["muted"])
    note.pack(pady=8)

    def refresh(event=None):
        tree.delete(*tree.get_children())
        game = None if choice.get() == "All Games" else choice.get()
        rows = get_top_scores(game)
        for rank, (name, score) in enumerate(rows, start=1):
            tag = {1: "gold", 2: "silver", 3: "bronze"}.get(rank, "")
            tree.insert("", "end", values=(rank, name, score), tags=(tag,))
        note.config(text="" if rows else "No scores yet - be the first to play!")

    combo.bind("<<ComboboxSelected>>", refresh)
    refresh()


def show_profile():
    if is_guest():
        messagebox.showinfo("Guest", "Guests do not have a profile.\nRegister an account to track your scores!")
        return
    clear_root()
    c = colors()
    build_header("My Profile", show_dashboard)

    history = get_user_history(current_user)
    stats = tk.Frame(root, bg=c["panel"], padx=20, pady=10)
    stats.pack(fill="x", padx=25, pady=12)
    make_label(stats, f"Games played: {len(history)}", 13, True, c["accent"], bg=c["panel"]).pack(side="left", padx=15)
    for name, info in GAMES.items():
        make_label(stats, f"{name} best: {get_best_score(current_user, name)}", 13, True,
                   info["color"], bg=c["panel"]).pack(side="left", padx=15)

    chart_frame = tk.Frame(root, bg=c["panel"])
    chart_frame.pack(fill="both", expand=True, padx=25, pady=(0, 15))

    if not MPL_OK:
        make_label(chart_frame, "Install matplotlib to see your chart:\npip install matplotlib",
                   13, bg=c["panel"]).pack(expand=True)
        return
    if not history:
        make_label(chart_frame, "No games played yet.\nPlay a game and your score chart will appear here!",
                   14, bg=c["panel"]).pack(expand=True)
        return

    figure = Figure(figsize=(8, 3.6), dpi=100, facecolor=c["panel"])
    axes = figure.add_subplot(111)
    axes.set_facecolor(c["panel"])
    for name, info in GAMES.items():
        scores = [s for g, s, _ in history if g == name]
        if scores:
            axes.plot(range(1, len(scores) + 1), scores, marker="o", linewidth=2.5,
                      color=info["color"], label=name)
    axes.set_title("My score history", color=c["fg"], fontsize=14, fontweight="bold")
    axes.set_xlabel("Attempt number", color=c["fg"])
    axes.set_ylabel("Score", color=c["fg"])
    axes.tick_params(colors=c["fg"])
    axes.xaxis.set_major_locator(MaxNLocator(integer=True))
    axes.grid(alpha=0.25)
    for spine in axes.spines.values():
        spine.set_color(c["muted"])
    legend = axes.legend(facecolor=c["panel"], edgecolor=c["muted"])
    for text in legend.get_texts():
        text.set_color(c["fg"])
    figure.tight_layout()

    canvas = FigureCanvasTkAgg(figure, master=chart_frame)
    canvas.draw()
    canvas.get_tk_widget().pack(fill="both", expand=True)



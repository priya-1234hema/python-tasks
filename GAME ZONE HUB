# =====================================================================
#  DATABASE FUNCTIONS (sqlite3 + hashlib)
# =====================================================================
def run_query(sql, params=(), fetch=False):
    """Run one SQL statement safely and return rows if fetch=True."""
    conn = sqlite3.connect(DB_PATH)
    try:
        cursor = conn.execute(sql, params)
        rows = cursor.fetchall() if fetch else None
        conn.commit()
        return rows
    finally:
        conn.close()


def init_database():
    """Create the tables the first time the program runs."""
    run_query("""
        CREATE TABLE IF NOT EXISTS users (
            id        INTEGER PRIMARY KEY AUTOINCREMENT,
            username  TEXT UNIQUE NOT NULL COLLATE NOCASE,
            salt      TEXT NOT NULL,
            pw_hash   TEXT NOT NULL,
            created   TEXT NOT NULL
        )""")
    run_query("""
        CREATE TABLE IF NOT EXISTS scores (
            id         INTEGER PRIMARY KEY AUTOINCREMENT,
            username   TEXT NOT NULL,
            game       TEXT NOT NULL,
            score      INTEGER NOT NULL,
            played_at  TEXT NOT NULL
        )""")


def hash_password(password, salt=None):
    """Return (salt, hash). A new random salt is made when none is given."""
    if salt is None:
        salt = secrets.token_hex(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"),
                                 bytes.fromhex(salt), 100000)
    return salt, digest.hex()


def register_user(username, password):
    """Create a new account. Returns (success, message)."""
    if len(username) < 3:
        return False, "Username must be at least 3 characters long."
    if username.lower() == GUEST_NAME.lower():
        return False, "That username is reserved. Please choose another."
    if len(password) < 4:
        return False, "Password must be at least 4 characters long."
    salt, pw_hash = hash_password(password)
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        run_query("INSERT INTO users (username, salt, pw_hash, created) "
                  "VALUES (?, ?, ?, ?)", (username, salt, pw_hash, now))
    except sqlite3.IntegrityError:
        return False, "Username already exists! Try logging in."
    return True, "Account registered successfully!\nPlease log in now."


def verify_login(username, password):
    """Return the stored username if the login is correct, else None."""
    rows = run_query("SELECT username, salt, pw_hash FROM users WHERE username = ?",
                     (username,), fetch=True)
    if not rows:
        return None
    stored_name, salt, stored_hash = rows[0]
    _, new_hash = hash_password(password, salt)
    if hmac.compare_digest(new_hash, stored_hash):
        return stored_name
    return None


def save_score(username, game, score):
    """Store one finished game in the scores table."""
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    run_query("INSERT INTO scores (username, game, score, played_at) VALUES (?, ?, ?, ?)",
              (username, game, int(score), now))


def get_top_scores(game=None, limit=10):
    """Best score of every player. game=None adds up each player's bests."""
    if game:
        return run_query(
            "SELECT username, MAX(score) AS best FROM scores WHERE game = ? "
            "GROUP BY username ORDER BY best DESC LIMIT ?", (game, limit), fetch=True)
    return run_query(
        "SELECT username, SUM(best) AS total FROM ("
        "  SELECT username, game, MAX(score) AS best FROM scores GROUP BY username, game"
        ") GROUP BY username ORDER BY total DESC LIMIT ?", (limit,), fetch=True)


def get_best_score(username, game):
    rows = run_query("SELECT MAX(score) FROM scores WHERE username = ? AND game = ?",
                     (username, game), fetch=True)
    return rows[0][0] or 0


def get_user_history(username):
    """All games of one player, oldest first: (game, score, played_at)."""
    return run_query("SELECT game, score, played_at FROM scores "
                     "WHERE username = ? ORDER BY id", (username,), fetch=True)


def delete_user_scores(username):
    run_query("DELETE FROM scores WHERE username = ?", (username,))



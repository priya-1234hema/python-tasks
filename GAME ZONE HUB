def lighten(hex_color, amount=30):
    r, g, b = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(min(255, v + amount) for v in (r, g, b))


def make_button(parent, text, command, color="#2196F3", width=16, font_size=12):
    button = tk.Button(parent, text=text, command=command, bg=color, fg="white",
                       activebackground=lighten(color), activeforeground="white",
                       relief="flat", bd=0, width=width, pady=6, cursor="hand2",
                       font=("Arial", font_size, "bold"))
    button.bind("<Enter>", lambda e: button.config(bg=lighten(color)))
    button.bind("<Leave>", lambda e: button.config(bg=color))
    return button



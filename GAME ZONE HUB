GAMES = {
    "Snake": {"color": "#2ecc71", "func": play_snake,
              "desc": "Eat apples, grow longer and don't crash!"},
    "Pong": {"color": "#3498db", "func": play_pong,
             "desc": "Beat the computer. First to 7 points wins."},
    "Catch": {"color": "#e67e22", "func": play_catch,
              "desc": "Catch the fruit and dodge the bombs."},
}


def launch_game(game_name):
    """Hide the hub, run the pygame game, then bring the hub back."""
    if not PYGAME_OK:
        messagebox.showerror("pygame missing",
                             "pygame is not installed.\n\nOpen a terminal and run:\npip install pygame")
        return

    previous_best = 0 if is_guest() else get_best_score(current_user, game_name)
    error = None
    score = 0

    root.withdraw()                      # tkinter and pygame must not run together
    try:
        score = GAMES[game_name]["func"](current_user, settings["sound"])
    except Exception as exc:             # never let a game bug close the whole hub
        error = exc
    finally:
        try:
            pygame.quit()
        except Exception:
            pass
        root.deiconify()
        root.lift()
        root.update()

    if error is not None:
        messagebox.showerror("Game error", f"The game stopped unexpectedly:\n{error}")
        return

    if is_guest():
        message = f"You scored {score} points!\n\nGuest scores are not saved.\nRegister to join the leaderboard."
    else:
        if score > 0:
            save_score(current_user, game_name, score)
        message = f"You scored {score} points!"
        if score > previous_best and score > 0:
            message += "\n\nNEW PERSONAL BEST!"
    messagebox.showinfo(f"{game_name} - Finished", message)
    show_dashboard()



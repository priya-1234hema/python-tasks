def show_register_screen():
    clear_root()
    c = colors()
    build_header("Create Account", show_welcome_screen)

    box = tk.Frame(root, bg=c["panel"], padx=40, pady=30)
    box.pack(pady=40)
    make_label(box, "New Username:", 12).pack(pady=(0, 3))

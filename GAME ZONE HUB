    make_label(box, "Confirm Password:", 12).pack(pady=(14, 3))
    confirm_entry = make_entry(box, show="*")
    confirm_entry.pack(ipady=5)

    def process_registration(event=None):
        username = user_entry.get().strip()
        password = pass_entry.get().strip()

    tk.Label(bar, text=title, font=("Arial", 20, "bold"), bg=c["panel"], fg=c["accent"]).pack(side="left", padx=8)
    tk.Label(bar, text=f"Player: {current_user}", font=("Arial", 12), bg=c["panel"],
             fg=c["muted"]).pack(side="right", padx=18)
    return bar


def draw_game_icon(canvas, game):
    """Little pictures drawn with code, so no image files are needed."""
    if game == "Snake":
        cells = [(1, 3), (2, 3), (2, 2), (2, 1), (3, 1), (4, 1), (4, 2), (5, 2)]
        for i, (x, y) in enumerate(cells):
            green = "#%02x%02x%02x" % (40, min(255, 120 + i * 18), 90)
            canvas.create_rectangle(10 + x * 22, 10 + y * 22, 30 + x * 22, 30 + y * 22, fill=green, outline="")
        canvas.create_oval(120, 38, 128, 46, fill="white", outline="")
        canvas.create_oval(120, 56, 128, 64, fill="white", outline="")
        canvas.create_oval(14, 28, 32, 46, fill="#e74c3c", outline="")
    elif game == "Pong":
        canvas.create_rectangle(20, 25, 30, 85, fill="#00d4ff", outline="")
        canvas.create_rectangle(130, 35, 140, 95, fill="#ff6384", outline="")
        canvas.create_oval(72, 47, 88, 63, fill="white", outline="")
        canvas.create_line(80, 5, 80, 105, dash=(4, 4), fill="#7a80b0", width=2)
    elif game == "Catch":
        canvas.create_oval(50, 8, 74, 32, fill="#e74c3c", outline="")
        canvas.create_oval(95, 30, 115, 50, fill="#f1c40f", outline="")
        canvas.create_oval(78, 4, 96, 22, fill="#9b59b6", outline="")
        canvas.create_polygon(40, 70, 120, 70, 108, 102, 52, 102, fill="#8b4513", outline="")
        canvas.create_rectangle(36, 64, 124, 72, fill="#be6e32", outline="")



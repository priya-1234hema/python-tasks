def clear_root():
    for widget in root.winfo_children():
        widget.destroy()
    root.configure(bg=colors()["bg"])


def rainbow_title(parent, text, size=36):
    frame = tk.Frame(parent, bg=parent["bg"])
    frame.letters = []
    for i, ch in enumerate(text):
        label = tk.Label(frame, text=ch if ch != " " else "  ", font=("Arial", size, "bold"),
                         fg=RAINBOW[i % len(RAINBOW)], bg=parent["bg"])
        label.pack(side="left")
        frame.letters.append(label)
    return frame


def animate_rainbow(frame, shift=0):
    """Make the title letters cycle through the rainbow colours."""
    try:
        if not frame.winfo_exists():
            return
        for i, label in enumerate(frame.letters):
            label.config(fg=RAINBOW[(i + shift) % len(RAINBOW)])
        root.after(300, lambda: animate_rainbow(frame, shift + 1))
    except tk.TclError:
        pass



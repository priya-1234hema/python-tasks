_FONTS = {}


def init_pygame_window(title, width, height):
    """Start pygame and open the game window."""
    _FONTS.clear()
    pygame.mixer.pre_init(22050, -16, 1, 512)
    pygame.init()
    screen = pygame.display.set_mode((width, height))
    pygame.display.set_caption(title)
    return screen, pygame.time.Clock()


def get_font(size):
    if size not in _FONTS:
        _FONTS[size] = pygame.font.SysFont("arial", size, bold=True)
    return _FONTS[size]


def draw_text(screen, text, size, color, center):
    surface = get_font(size).render(text, True, color)
    screen.blit(surface, surface.get_rect(center=center))


def make_gradient(width, height, top_color, bottom_color):
    surface = pygame.Surface((width, height))
    for y in range(height):
        ratio = y / max(1, height - 1)
        color = tuple(int(top_color[i] + (bottom_color[i] - top_color[i]) * ratio)
                      for i in range(3))
        pygame.draw.line(surface, color, (0, y), (width, y))
    return surface


def tone_samples(freq, ms, volume, rate):
    """Build a square-wave beep (freq=0 gives silence)."""
    count = int(rate * ms / 1000)
    amp = 32767 * volume
    data = array("h")
    for i in range(count):
        if freq == 0:
            value = 0
        else:
            value = amp if int(i * freq * 2 / rate) % 2 == 0 else -amp
        value *= (1 - i / count)          # fade out so there is no click
        data.append(int(value))
    return data


def samples_to_sound(samples):
    """Turn raw samples into a pygame Sound (None if no audio device)."""
    try:
        info = pygame.mixer.get_init()
        if not info or info[1] != -16:
            return None
        if info[2] == 2:                   # duplicate samples for stereo
            stereo = array("h")
            for s in samples:
                stereo.append(s)
                stereo.append(s)
            samples = stereo
        return pygame.mixer.Sound(buffer=samples.tobytes())
    except Exception:
        return None


def make_beep(freq, ms, volume=0.25):
    info = pygame.mixer.get_init() if pygame.mixer.get_init() else None
    if not info:
        return None
    return samples_to_sound(tone_samples(freq, ms, volume, info[0]))


def start_music(sound_on):
    """Play a quiet looping tune in the background."""
    if not sound_on:
        return None
    info = pygame.mixer.get_init()
    if not info:
        return None
    notes = [523, 659, 784, 659, 587, 740, 880, 740,
             523, 659, 784, 1046, 880, 784, 659, 587]
    samples = array("h")
    for freq in notes:
        samples.extend(tone_samples(freq, 220, 0.05, info[0]))
    music = samples_to_sound(samples)
    if music:
        music.play(loops=-1)
    return music


def play_sound(sound, sound_on):
    if sound_on and sound:
        sound.play()


def game_over_screen(screen, score, title="GAME OVER", subtitle="", color=(255, 80, 80)):
    """Dim the game, show the score and wait for a key press."""
    width, height = screen.get_size()
    overlay = pygame.Surface((width, height), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 170))
    screen.blit(overlay, (0, 0))
    draw_text(screen, title, 56, color, (width // 2, height // 2 - 70))
    draw_text(screen, f"Score: {score}", 38, (255, 255, 255), (width // 2, height // 2))
    if subtitle:
        draw_text(screen, subtitle, 22, (255, 215, 0), (width // 2, height // 2 + 50))
    draw_text(screen, "Press any key to return to the hub", 20, (200, 200, 200),
              (width // 2, height // 2 + 100))
    pygame.display.flip()

    start = pygame.time.get_ticks()
    while pygame.time.get_ticks() - start < 10000:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return
            if event.type == pygame.KEYDOWN and pygame.time.get_ticks() - start > 600:
                return
        pygame.time.wait(30)


def random_free_cell(occupied, cols, rows):
    free = [(x, y) for x in range(cols) for y in range(rows) if (x, y) not in occupied]
    return random.choice(free) if free else None



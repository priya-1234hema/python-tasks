def serve_velocity(speed, direction):
    """Random starting direction for the ball."""
    angle = random.uniform(-0.5, 0.5)
    return speed * direction * math.cos(angle), speed * math.sin(angle)


def play_pong(user, sound_on=True):
    """Pong against the computer. First to 7 points wins. Returns the score."""
    W, H = 800, 500
    PADDLE_W, PADDLE_H, RADIUS, WIN_POINTS = 12, 90, 9, 7
    screen, clock = init_pygame_window(f"Pong - {user}", W, H)

    hit_sound = make_beep(660, 60)
    point_sound = make_beep(990, 200)
    lose_sound = make_beep(200, 300, 0.3)
    music = start_music(sound_on)

    player = pygame.Rect(30, H // 2 - PADDLE_H // 2, PADDLE_W, PADDLE_H)
    cpu = pygame.Rect(W - 30 - PADDLE_W, H // 2 - PADDLE_H // 2, PADDLE_W, PADDLE_H)
    ball_x, ball_y = W / 2, H / 2
    speed = 6.0
    vx, vy = serve_velocity(speed, random.choice([-1, 1]))
    player_points = cpu_points = 0
    window_closed = False

    while player_points < WIN_POINTS and cpu_points < WIN_POINTS:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                window_closed = True
            elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                window_closed = True
            elif event.type == pygame.MOUSEMOTION:
                player.centery = event.pos[1]
        if window_closed:
            break

        keys = pygame.key.get_pressed()
        if keys[pygame.K_UP] or keys[pygame.K_w]:
            player.y -= 8
        if keys[pygame.K_DOWN] or keys[pygame.K_s]:
            player.y += 8
        player.clamp_ip(screen.get_rect())

        # computer paddle: follows the ball a little slower than it moves
        target = ball_y if vx > 0 else H / 2
        if cpu.centery < target - 12:
            cpu.y += 5
        elif cpu.centery > target + 12:
            cpu.y -= 5
        cpu.clamp_ip(screen.get_rect())

        # move the ball and bounce off the top and bottom
        ball_x += vx
        ball_y += vy
        if ball_y - RADIUS <= 0:
            ball_y, vy = RADIUS, abs(vy)
        elif ball_y + RADIUS >= H:
            ball_y, vy = H - RADIUS, -abs(vy)

        ball_rect = pygame.Rect(int(ball_x - RADIUS), int(ball_y - RADIUS), RADIUS * 2, RADIUS * 2)
        if vx < 0 and ball_rect.colliderect(player):
            speed = min(speed + 0.4, 13)
            offset = max(-1, min(1, (ball_y - player.centery) / (PADDLE_H / 2)))
            angle = offset * math.radians(55)
            vx, vy = speed * math.cos(angle), speed * math.sin(angle)
            ball_x = player.right + RADIUS + 1
            play_sound(hit_sound, sound_on)
        elif vx > 0 and ball_rect.colliderect(cpu):
            speed = min(speed + 0.4, 13)
            offset = max(-1, min(1, (ball_y - cpu.centery) / (PADDLE_H / 2)))
            angle = offset * math.radians(55)
            vx, vy = -speed * math.cos(angle), speed * math.sin(angle)
            ball_x = cpu.left - RADIUS - 1
            play_sound(hit_sound, sound_on)

        # somebody scored?
        scored = False
        if ball_x < 0:
            cpu_points += 1
            play_sound(lose_sound, sound_on)
            scored, serve_dir = True, -1
        elif ball_x > W:
            player_points += 1
            play_sound(point_sound, sound_on)
            scored, serve_dir = True, 1

        # ---- draw ----
        screen.fill((15, 20, 45))
        for y in range(0, H, 24):
            pygame.draw.rect(screen, (60, 70, 120), (W // 2 - 2, y, 4, 12))
        pygame.draw.rect(screen, (0, 212, 255), player, border_radius=6)
        pygame.draw.rect(screen, (255, 99, 132), cpu, border_radius=6)
        pygame.draw.circle(screen, (255, 255, 255), (int(ball_x), int(ball_y)), RADIUS)
        draw_text(screen, str(player_points), 60, (0, 212, 255), (W // 2 - 70, 50))
        draw_text(screen, str(cpu_points), 60, (255, 99, 132), (W // 2 + 70, 50))
        draw_text(screen, f"First to {WIN_POINTS} wins  |  W/S or mouse to move",
                  16, (130, 140, 190), (W // 2, H - 15))
        pygame.display.flip()

        if scored:
            ball_x, ball_y = W / 2, H / 2
            speed = 6.0
            vx, vy = serve_velocity(speed, serve_dir)
            pygame.time.wait(600)
            pygame.event.clear()
        clock.tick(60)

    if music:
        music.stop()
    won = player_points >= WIN_POINTS
    score = player_points * 10 + (50 if won else 0)
    if not window_closed:
        if won:
            game_over_screen(screen, score, "YOU WIN!", f"{player_points} - {cpu_points}  (+50 bonus)",
                             (80, 255, 120))
        else:
            game_over_screen(screen, score, "COMPUTER WINS", f"{player_points} - {cpu_points}")
    return score



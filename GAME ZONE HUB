def play_catch(user, sound_on=True):
    """Catch fruit, avoid bombs. Returns the final score."""
    W, H = 700, 600
    screen, clock = init_pygame_window(f"Catch the Fruit - {user}", W, H)

    catch_sound = make_beep(784, 70)
    gold_sound = make_beep(1175, 150)
    bomb_sound = make_beep(120, 400, 0.35)
    music = start_music(sound_on)

    background = make_gradient(W, H, (110, 190, 250), (255, 240, 200))
    fruit_colors = [(231, 76, 60), (241, 196, 15), (155, 89, 182), (46, 204, 113), (230, 126, 34)]
    basket = pygame.Rect(W // 2 - 55, H - 55, 110, 28)

    items = []
    spawn_timer = 0
    score = 0
    lives = 3
    window_closed = False

    while lives > 0:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                window_closed = True
            elif event.type == pygame.KEYDOWN and event.key == pygame.K_ESCAPE:
                window_closed = True
            elif event.type == pygame.MOUSEMOTION:
                basket.centerx = event.pos[0]
        if window_closed:
            break

        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] or keys[pygame.K_a]:
            basket.x -= 10
        if keys[pygame.K_RIGHT] or keys[pygame.K_d]:
            basket.x += 10
        basket.clamp_ip(screen.get_rect())

        level = score // 100 + 1

        # ---- spawn new items ----
        spawn_timer += 1
        if spawn_timer >= max(18, 55 - level * 4):
            spawn_timer = 0
            roll = random.random()
            bomb_chance = min(0.18 + 0.02 * level, 0.40)
            if roll < bomb_chance:
                kind = "bomb"
            elif roll < bomb_chance + 0.06:
                kind = "gold"
            else:
                kind = "fruit"
            items.append({"x": random.randint(25, W - 25), "y": -20, "r": 16, "kind": kind,
                          "speed": 3 + level * 0.5 + random.uniform(0, 1.5),
                          "color": random.choice(fruit_colors)})

        # ---- move items and check catches ----
        remaining = []
        for item in items:
            item["y"] += item["speed"]
            r = item["r"]
            item_rect = pygame.Rect(item["x"] - r, int(item["y"]) - r, r * 2, r * 2)
            if item_rect.colliderect(basket):
                if item["kind"] == "bomb":
                    lives -= 1
                    play_sound(bomb_sound, sound_on)
                elif item["kind"] == "gold":
                    score += 30
                    play_sound(gold_sound, sound_on)
                else:
                    score += 10
                    play_sound(catch_sound, sound_on)
            elif item["y"] - r <= H:
                remaining.append(item)
        items = remaining

        # ---- draw ----
        screen.blit(background, (0, 0))
        for item in items:
            x, y, r = item["x"], int(item["y"]), item["r"]
            if item["kind"] == "bomb":
                pygame.draw.circle(screen, (35, 35, 40), (x, y), r)
                pygame.draw.line(screen, (120, 80, 40), (x + 6, y - r + 3), (x + 12, y - r - 7), 3)
                pygame.draw.circle(screen, (255, 90, 30), (x + 12, y - r - 8), 4)
                pygame.draw.circle(screen, (90, 90, 100), (x - 5, y - 5), 4)
            elif item["kind"] == "gold":
                pygame.draw.circle(screen, (255, 200, 0), (x, y), r + 2)
                pygame.draw.circle(screen, (255, 245, 150), (x, y), r - 5)
                pygame.draw.circle(screen, (255, 255, 255), (x - 5, y - 5), 3)
            else:
                pygame.draw.circle(screen, item["color"], (x, y), r)
                pygame.draw.circle(screen, (255, 255, 255), (x - 5, y - 5), 4)
                pygame.draw.line(screen, (60, 120, 40), (x, y - r), (x + 4, y - r - 8), 3)

        pygame.draw.polygon(screen, (139, 69, 19),
                            [(basket.left, basket.top), (basket.right, basket.top),
                             (basket.right - 15, basket.bottom), (basket.left + 15, basket.bottom)])
        pygame.draw.rect(screen, (190, 110, 50), (basket.left - 4, basket.top - 5, basket.width + 8, 8),
                         border_radius=4)

        pygame.draw.rect(screen, (30, 30, 70), (0, 0, W, 44))
        draw_text(screen, f"Score: {score}", 24, (255, 215, 0), (90, 22))
        draw_text(screen, f"Level {level}", 24, (255, 255, 255), (W // 2, 22))
        for i in range(lives):
            pygame.draw.circle(screen, (255, 70, 90), (W - 40 - i * 30, 22), 11)
            pygame.draw.circle(screen, (255, 255, 255), (W - 44 - i * 30, 18), 3)
        pygame.display.flip()
        clock.tick(60)

    if music:
        music.stop()
    if not window_closed:
        game_over_screen(screen, score, "GAME OVER", "A bomb got you!")
    return score



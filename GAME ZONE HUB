#  GAME 1 : SNAKE
# =====================================================================
def play_snake(user, sound_on=True):
    """Classic snake. Returns the final score."""
    CELL, COLS, ROWS, TOP = 20, 30, 28, 50
    width, height = COLS * CELL, ROWS * CELL + TOP
    screen, clock = init_pygame_window(f"Snake - {user}", width, height)

    eat_sound = make_beep(880, 90)
    die_sound = make_beep(160, 500, 0.3)
    music = start_music(sound_on)

    snake = [(15, 14), (14, 14), (13, 14)]
    direction = (1, 0)
    next_direction = direction
    food = random_free_cell(set(snake), COLS, ROWS)
    score = 0
    speed = 8
    alive = True
    window_closed = False

    while alive and not window_closed:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                window_closed = True
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    window_closed = True
                elif event.key in (pygame.K_UP, pygame.K_w) and direction != (0, 1):
                    next_direction = (0, -1)
                elif event.key in (pygame.K_DOWN, pygame.K_s) and direction != (0, -1):
                    next_direction = (0, 1)
                elif event.key in (pygame.K_LEFT, pygame.K_a) and direction != (1, 0):
                    next_direction = (-1, 0)
                elif event.key in (pygame.K_RIGHT, pygame.K_d) and direction != (-1, 0):
                    next_direction = (1, 0)
        if window_closed:
            break

        # ---- move the snake ----
        direction = next_direction
        head = (snake[0][0] + direction[0], snake[0][1] + direction[1])
        eating = (head == food)
        body = snake if eating else snake[:-1]
        if not (0 <= head[0] < COLS and 0 <= head[1] < ROWS) or head in body:
            alive = False
        else:
            snake.insert(0, head)
            if eating:
                score += 10
                speed = min(8 + score // 40, 20)
                play_sound(eat_sound, sound_on)
                food = random_free_cell(set(snake), COLS, ROWS)
                if food is None:           # the board is full: perfect game!
                    alive = False
            else:
                snake.pop()

        # ---- draw everything ----
        screen.fill((18, 18, 40))
        for r in range(ROWS):
            for c in range(COLS):
                if (r + c) % 2 == 0:
                    pygame.draw.rect(screen, (25, 25, 55), (c * CELL, TOP + r * CELL, CELL, CELL))
        pygame.draw.rect(screen, (30, 30, 70), (0, 0, width, TOP))
        draw_text(screen, f"Score: {score}", 26, (255, 215, 0), (90, TOP // 2))
        draw_text(screen, "SNAKE", 28, (255, 255, 255), (width // 2, TOP // 2))
        draw_text(screen, f"Speed: {speed}", 22, (0, 212, 255), (width - 90, TOP // 2))

        if food:
            fx = food[0] * CELL + CELL // 2
            fy = TOP + food[1] * CELL + CELL // 2
            pygame.draw.circle(screen, (231, 76, 60), (fx, fy), CELL // 2 - 2)
            pygame.draw.circle(screen, (255, 255, 255), (fx - 3, fy - 3), 3)

        for i, (sx, sy) in enumerate(snake):
            rect = pygame.Rect(sx * CELL + 1, TOP + sy * CELL + 1, CELL - 2, CELL - 2)
            if i == 0:
                pygame.draw.rect(screen, (0, 255, 150), rect, border_radius=7)
                cx, cy = rect.center
                px, py = -direction[1], direction[0]       # sideways direction
                for side in (-1, 1):
                    ex = cx + direction[0] * 4 + px * 4 * side
                    ey = cy + direction[1] * 4 + py * 4 * side
                    pygame.draw.circle(screen, (255, 255, 255), (ex, ey), 3)
                    pygame.draw.circle(screen, (0, 0, 0), (ex, ey), 1)
            else:
                shade = max(90, 230 - i * 5)
                pygame.draw.rect(screen, (30, shade, 100), rect, border_radius=6)

        pygame.display.flip()
        clock.tick(speed)

    if music:
        music.stop()
    if not window_closed:
        play_sound(die_sound, sound_on)
        game_over_screen(screen, score, "GAME OVER")
    return score


